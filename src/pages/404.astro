---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found | Earth">
  <main id="main" class="min-h-screen bg-base-200 flex items-center justify-center text-center px-6 relative overflow-hidden">
    {/* Subtle radial ambient gradient */}
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[500px] h-[500px] bg-primary/5 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="max-w-md w-full relative z-10 flex flex-col items-center gap-6">
      <div class="font-mono font-medium text-7xl tracking-tighter text-primary">404</div>
      <h1 class="text-4xl font-bold tracking-tight text-white font-display">Page not found.</h1>
      <p class="text-gray-400 text-sm md:text-base leading-relaxed max-w-sm">
        The page you were looking for doesn't exist or has moved.
      </p>

      {/* Navigation-helpful chips */}
      <div class="flex flex-wrap justify-center gap-3 mt-2">
        <a href="/" class="px-3 py-1 rounded border border-white/8 hover:border-primary/40 text-xs font-mono text-gray-400 hover:text-white transition-colors duration-200 bg-white/5 inline-flex items-center gap-1.5">
          Home
        </a>
        <a href="/projects" class="px-3 py-1 rounded border border-white/8 hover:border-primary/40 text-xs font-mono text-gray-400 hover:text-white transition-colors duration-200 bg-white/5 inline-flex items-center gap-1.5">
          Projects
        </a>
        <a href="/blog" class="px-3 py-1 rounded border border-white/8 hover:border-primary/40 text-xs font-mono text-gray-400 hover:text-white transition-colors duration-200 bg-white/5 inline-flex items-center gap-1.5">
          Blog
        </a>
      </div>

      <button id="back-btn" class="text-xs font-mono text-gray-500 hover:text-white transition-colors mt-4 cursor-pointer">
        ← Back to previous page
      </button>
    </div>
  </main>
</Layout>

<script>
  document.getElementById("back-btn")?.addEventListener("click", () => {
    window.history.back();
  });
</script>
