---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Work Experience | Earth">
    <div class="min-h-dvh bg-base-200 pt-24 px-6">
        <div class="container mx-auto max-w-4xl">
            <span class="block text-xs font-mono text-gray-500 uppercase tracking-widest mb-2 gsap-reveal gsap-up">
                // experience — timeline
            </span>
            <h1
                class="text-5xl font-bold text-base-content mb-8 gsap-reveal gsap-up"
            >
                Work Experience
            </h1>

            <div class="mb-10 rounded-xl border border-white/8 bg-base-100/60 backdrop-blur-sm p-6 shadow-[var(--shadow-soft)] hover:shadow-[var(--shadow-soft-hover)] transition-all duration-300 gsap-reveal gsap-up">
                <p class="text-lg font-semibold text-white mb-2">
                    No professional job experience yet.
                </p>
                <p class="text-base-content/70 leading-relaxed text-sm">
                    This page is used to show practical project work, technical growth, and the kinds of systems I have been building while preparing for an AI engineer role.
                </p>
            </div>

            <div class="space-y-8">
                <div class="bg-base-100/60 rounded-xl border border-white/8 border-l-2 border-l-primary/30 backdrop-blur-sm shadow-[var(--shadow-soft)] hover:shadow-[var(--shadow-soft-hover)] transition-all duration-300 p-6 pl-6 gsap-reveal gsap-up">
                    <h2 class="text-2xl font-bold text-white mb-1">Meguri</h2>
                    <p class="text-xs font-mono text-base-content/60 uppercase tracking-wider mb-3">
                        Personal project • AI / Inventory / Forecasting
                    </p>
                    <p class="text-sm text-base-content/85 leading-relaxed">
                        Building a workspace-scoped smart stock platform for recipe-based businesses and small retail, with inventory management, recipe/BOM mapping, supplier planning, alerts, and forecasting.
                    </p>
                </div>

                <div class="bg-base-100/60 rounded-xl border border-white/8 border-l-2 border-l-primary/30 backdrop-blur-sm shadow-[var(--shadow-soft)] hover:shadow-[var(--shadow-soft-hover)] transition-all duration-300 p-6 pl-6 gsap-reveal gsap-up">
                    <h2 class="text-2xl font-bold text-white mb-1">Portfolio & Learning Projects</h2>
                    <p class="text-xs font-mono text-base-content/60 uppercase tracking-wider mb-3">
                        Personal projects • Full stack / AI-focused work
                    </p>
                    <p class="text-sm text-base-content/85 leading-relaxed">
                        Built projects such as NextMart, BookCube, and Kitchen Inventory to strengthen full-stack engineering, data modeling, and product thinking while moving toward AI engineer roles.
                    </p>
                </div>
            </div>
        </div>
    </div>
</Layout>
