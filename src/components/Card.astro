---
import "../assets/app.css";

export interface Props {
  name: string;
  desc?: string;
  skill1?: string;
  skill2?: string;
  skill3?: string;
  github?: string;
  image?: string;
  /** When provided the card links to /projects/[slug] instead of directly to github */
  slug?: string;
}

const { name, desc, skill1, skill2, skill3, github, image, slug } = Astro.props;

const skills = [skill1, skill2, skill3].filter((skill) => skill);
const href = slug ? `/projects/${slug}` : github;
const isExternal = !slug;
---

<a
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  class="block group"
  aria-label={`View project: ${name}`}
>
  <div
    class="bg-base-100/60 rounded-xl overflow-hidden border border-white/8 backdrop-blur-sm shadow-[var(--shadow-soft)] hover:shadow-[var(--shadow-soft-hover)] hover:border-white/12 transition-all duration-300 gsap-reveal gsap-up"
  >
    {/* Image Container */}
    <div class="relative h-48 overflow-hidden">
      {
        image && (
          <img
            src={image}
            alt={name}
            loading="lazy"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        )
      }
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/40 via-black/10 to-transparent transition-opacity duration-300"
      >
      </div>
    </div>

    {/* Content */}
    <div class="p-6 space-y-4">
      <h3
        class="text-xl font-bold text-white group-hover:text-primary transition-colors"
      >
        {name}
      </h3>

      <p class="text-gray-300 text-sm leading-relaxed line-clamp-2">
        {desc}
      </p>

      {/* Tags */}
      {
        skills.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-2">
            {skills.map((skill) => (
              <span class="skill-chip">
                {skill}
              </span>
            ))}
          </div>
        )
      }

      {/* View details indicator */}
      <div class="flex items-center gap-1.5 text-xs text-primary/70 group-hover:text-primary transition-colors pt-1">
        <span>{slug ? "View details" : "View project"}</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </div>
    </div>
  </div>
</a>
