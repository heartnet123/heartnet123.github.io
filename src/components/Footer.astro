---
const currentYear = new Date().getFullYear();
---

<footer class="pb-12 pt-8 bg-base-200 border-t border-white/5 mt-auto text-xs font-mono text-gray-500">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
      {/* Left: Wordmark */}
      <div class="text-center md:text-left text-sm font-semibold text-white tracking-wider">
        Earth.
      </div>
      {/* Center: Copyright */}
      <div class="text-center">
        © {currentYear} — Built with Astro + Tailwind + GSAP
      </div>
      {/* Right: Links */}
      <div class="flex justify-center md:justify-end gap-6">
        <a href="https://github.com/heartnet123" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">GitHub</a>
        <a href="mailto:jaruvit.rpg@gmail.com" class="hover:text-white transition-colors">Email</a>
        <a href="#main" class="hover:text-white transition-colors flex items-center gap-1">
          Back to top ↑
        </a>
      </div>
    </div>
  </div>
</footer>
